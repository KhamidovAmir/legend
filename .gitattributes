# Shell scripts are mounted into Linux containers: with CRLF (Windows checkout, core.autocrlf=true) bash fails
# with "set: pipefail\r: invalid option name". Keep LF regardless of the developer's OS.
* text=auto
*.sh text eol=lf
*.py text eol=lf
Makefile text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
